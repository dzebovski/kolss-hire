# New HR Slack bot, scopes chat:write and files:write. Never reuse the CRM token.
SLACK_HR_BOT_TOKEN=
# Private HR channel ID; invite the new bot to this channel.
SLACK_HR_CHANNEL_ID=
# Public canonical site origin (production: https://prace.kolss.eu).
NEXT_PUBLIC_SITE_URL=
# Public recruitment-only Meta Pixel/dataset ID. Empty disables all tracking.
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only Conversions API token for the recruitment dataset.
META_CAPI_ACCESS_TOKEN=
# Latest version verified 2026-10-07 in Meta changelog: v26.0.
META_GRAPH_API_VERSION=
# Optional Events Manager test code; remove before going live.
META_TEST_EVENT_CODE=
# Optional content value for the facebook-domain-verification meta tag.
META_DOMAIN_VERIFICATION=
